# ─────────────────────────────────────────────────────────────
#  Credenciais do GoHighLevel — COPIE este arquivo para `.env` e preencha.
#  O `.env` NÃO é versionado (está no .gitignore). NUNCA commite o token.
# ─────────────────────────────────────────────────────────────

# ── API OFICIAL (Private Integration Token) ──────────────────
# Settings → Private Integrations → Create New Integration → copie o pit-...
# Usado para: contatos, pipelines, custom fields, calendários (tudo "abençoado").
GHL_PIT_TOKEN=pit-xxxxxxxxxxxxxxxxxxxxxxxx
GHL_LOCATION_ID=xxxxxxxxxxxxxxxxxxxx
GHL_API_BASE=https://services.leadconnectorhq.com
GHL_API_VERSION=2021-07-28

# ── API INTERNA (Firebase) — AVANÇADO / OPCIONAL ─────────────
# ⚠️ Este token é o LOGIN INTEIRO da sua conta. Use SÓ na sua própria conta.
# Pegue com a extensão em extension/ (Copiar → cole aqui). O refresh token é
# de longa duração e renova o token-id sozinho — prefira ele.
# Usado para: criar workflows, dashboards, pastas (API não-oficial do GHL).
GHL_FIREBASE_REFRESH_TOKEN=
GHL_FIREBASE_TOKEN=
